{
  "version": 2,
  "builds": [
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/playground$", "dest": "/assets/html/playground.html" },
    { "src": "^/game$", "dest": "/assets/html/game.html" },
    { "src": "^/tiktok$", "dest": "/assets/html/ttdl.html" },
    { "src": "^/instagram$", "dest": "/assets/html/igdl.html" },
    { "src": "^/facebook$", "dest": "/assets/html/fbdl.html" },
    { "src": "^/capcut$", "dest": "/assets/html/ccdl.html" },
    { "src": "^/donate$", "dest": "/assets/html/donate.html" }
  ]
}
